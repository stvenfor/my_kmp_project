<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ 云备份 / 设备迁移规则：不迁移 SharedPreferences（会话 token 等）。 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
