<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug-only manifest overlay（AGP 标准 variant 源集 src/debug）。

  仅 debug 构建允许明文 HTTP：本机后端 http://127.0.0.1:8080（adb reverse）
  或局域网 http://192.168.x.x:8080。release 不带该覆盖，保持平台默认禁止明文。

  资源本体只有一份：composeApp/src/androidDebug/res/xml/network_security_config.xml。
  manifest 覆盖必须留在 AGP 标准 src/debug 源集，否则不会参与 manifest 合并。
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        tools:replace="android:usesCleartextTraffic" />

</manifest>
